# ==============================================================================
# 방송통신대학교 컴퓨터과학과 [머신러닝] 출석수업 과제 실습 코드
# 주제: Iris(붓꽃) 데이터셋 K-NN 4단계 머신러닝 파이프라인 실습
# ==============================================================================

import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score, confusion_matrix
from sklearn.decomposition import PCA

# [1단계] 데이터 로드 및 분할
iris = load_iris()
X_tr, X_te, y_tr, y_te = train_test_split(
    iris.data, iris.target, test_size=0.4, random_state=None, stratify=iris.target
)

# [2단계] K값(1~15) 및 거리함수(유클리디안 L2 vs 맨해튼 L1) 성능 비교
print("=== [실험 1] K값 및 거리함수별 테스트 정확도 비교 ===")
print("---------------------------------------------------------")
print(f"{'K값':<5} | {'유클리디안 거리 (L2, p=2)':<24} | {'맨해튼 거리 (L1, p=1)':<20}")
print("---------------------------------------------------------")
for k in [1, 3, 5, 7, 9, 15]:
    knn_l2 = KNeighborsClassifier(n_neighbors=k, p=2).fit(X_tr, y_tr)
    acc_l2 = accuracy_score(y_te, knn_l2.predict(X_te))
    knn_l1 = KNeighborsClassifier(n_neighbors=k, p=1).fit(X_tr, y_tr)
    acc_l1 = accuracy_score(y_te, knn_l1.predict(X_te))
    print(f"K={k:<3} | {acc_l2*100:6.1f}%                   | {acc_l1*100:6.1f}%")

# [3단계] K=1, 5, 15 모델별 혼동행렬 출력
print("\n=== [실험 2] K=1, 5, 15 혼동행렬 (Confusion Matrix) ===")
species = ['Setosa    ', 'Versicolor', 'Virginica ']
for k in [1, 5, 15]:
    knn = KNeighborsClassifier(n_neighbors=k, p=2).fit(X_tr, y_tr)
    cm = confusion_matrix(y_te, knn.predict(X_te))
    print(f"\n[K={k} 혼동행렬 (유클리디안)]")
    print("예측클래스 ->   Setosa(0)  Versicolor(1)  Virginica(2)")
    for i, row in enumerate(cm):
        print(f"실제 {species[i]}:   {row[0]:^6}       {row[1]:^6}         {row[2]:^6}")

# [4단계] PCA 2차원 사영 & K값별(K=1, 5, 15) 결정경계 시각화 플롯 출력
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_tr)

plt.figure(figsize=(13, 4))
for idx, k_val in enumerate([1, 5, 15]):
    clf = KNeighborsClassifier(n_neighbors=k_val, p=2).fit(X_pca, y_tr)
    x_min, x_max = X_pca[:, 0].min() - 1, X_pca[:, 0].max() + 1
    y_min, y_max = X_pca[:, 1].min() - 1, X_pca[:, 1].max() + 1
    xx, yy = np.meshgrid(np.arange(x_min, x_max, 0.05), np.arange(y_min, y_max, 0.05))
    Z = clf.predict(np.c_[xx.ravel(), yy.ravel()]).reshape(xx.shape)
    
    plt.subplot(1, 3, idx + 1)
    plt.contourf(xx, yy, Z, alpha=0.3, cmap=plt.cm.coolwarm)
    plt.scatter(X_pca[:, 0], X_pca[:, 1], c=y_tr, cmap=plt.cm.coolwarm, edgecolors='k', s=35)
    plt.title(f"K = {k_val} Decision Boundary")
    plt.xlabel("PCA 1 (Max Variance Axis)")
    plt.ylabel("PCA 2")

plt.tight_layout()
plt.show()
